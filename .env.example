# Required for L7 (crewAI + md→json)
OPENAI_API_KEY=sk-...

# Required for prepare notebook (PDF parse)
LLAMA_CLOUD_API_KEY=llx-...
LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai

# Default LLM backend for prepare notebook (helper.get_llm)
CURSOR_API_KEY=crsr_...
# CURSOR_MODEL=composer-2.5
# LLM_BACKEND=cursor
# EMBED_BACKEND=huggingface
# EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# Optional: only if you re-enable Serper / web tools in L7
SERPER_API_KEY=

# Model used by crewAI / OpenAI client helpers
OPENAI_MODEL_NAME=gpt-4o-mini
